{
  "name": "tiara-web-app",
  "private": true,
  "description": "A web application for the new club 'TIARA', built with Vue, Hono, and Go.",
  "pnpm": {
    "overrides": {
      "jsdom": "^26.1.0"
    }
  },
  "scripts": {
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:bff": "pnpm --filter bff dev",
    "test": "pnpm --filter frontend test && pnpm --filter bff test",
    "test:frontend": "pnpm --filter frontend test",
    "test:bff": "pnpm --filter bff test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "packages/frontend/src/**/*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/bff/src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.2.5",
    "typescript-eslint": "^8.59.3"
  }
}
