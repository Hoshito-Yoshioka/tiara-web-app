# ============================================================
# 本番環境 環境変数テンプレート — Xserver VPS
#
# 使い方:
#   cp .env.production.example .env.production
#   # 各値を編集
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# .env.production は .gitignore に追加済み。リポジトリにコミットしないこと。
# ============================================================

# ==============================
# [必須] Docker Compose 用（DB / Backend / BFF 共通）
# ==============================

# --- PostgreSQL ---
POSTGRES_DB=tiara
POSTGRES_USER=tiara_user
POSTGRES_PASSWORD=                  # 強力なパスワードを設定すること（生成例: openssl rand -base64 24）

# --- Backend (Go) ---
JWT_SECRET=                         # JWT 署名秘密鍵（生成例: openssl rand -base64 32）
BACKEND_CORS_ORIGIN=http://bff:3001 # Docker 内部ネットワーク経由の BFF からのリクエストを許可

# --- BFF (Hono) ---
BFF_CORS_ORIGIN=https://tiara.example.com  # Nginx 経由のフロントエンドドメイン

# ==============================
# [必須] Frontend ビルド用（VPS 上で pnpm --filter frontend build 時に使用）
# ==============================

# フロントエンドが API リクエストを送る URL（Nginx 経由のドメイン）
VITE_API_BASE_URL=https://tiara.example.com

# サイトマップ生成・SSG プリレンダリングがスタッフ一覧を取得する API の絶対 URL
# （通常は公開ドメイン。未設定だと localhost:3001 にフォールバックする）
SITEMAP_API_BASE_URL=https://tiara.example.com

# 管理画面のベースパス（URL から推測されないよう変更を推奨）
# 例: /mgmt, /dashboard-secret など
# 変更した場合は管理者ユーザーへ周知すること
VITE_ADMIN_BASE_PATH=/admin
