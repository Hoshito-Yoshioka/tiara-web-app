# ============================================================
# 本番環境 環境変数テンプレート
# このファイルをコピーして .env.production として使用する。
# .env.production は .gitignore に追加し、リポジトリにコミットしないこと。
# ============================================================

# ==============================
# [必須] Backend (Go)
# ==============================

# PostgreSQL 接続文字列
# Lightsail Managed DB の「接続文字列」からコピーする
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/tiara

# JWT 署名秘密鍵（32文字以上のランダム文字列を使用すること）
# 生成例: openssl rand -base64 32
JWT_SECRET=

# BFF から Backend へのリクエストを許可する CORS オリジン
# カンマ区切りで複数指定可能: https://tiara.example.com,https://preview.tiara.example.com
CORS_ORIGIN=https://tiara.example.com

# Go サーバーのリッスンポート（変更不要）
PORT=1323

# アップロードファイルの保存先ディレクトリ（S3 移行前は変更不要）
UPLOAD_DIR=uploads

# 環境識別子（production に設定すると seed データの投入をスキップ）
APP_ENV=production

# ==============================
# [必須] BFF (Hono / Node.js)
# ==============================

# バックエンドの内部 URL（VPS 同居時は localhost で OK）
BACKEND_URL=http://localhost:1323

# フロントエンドからの CORS を許可するオリジン
CORS_ORIGIN=https://tiara.example.com

# BFF のリッスンポート（変更不要）
PORT=3001

# ==============================
# [必須] Frontend (Vue / Vite ビルド時)
# ==============================

# フロントエンドが API リクエストを送る BFF の URL
VITE_API_BASE_URL=https://tiara.example.com

# 管理画面のベースパス（URL から推測されないよう変更を推奨）
# 例: /mgmt, /dashboard-secret など
# 変更した場合は管理者ユーザーへ周知すること
VITE_ADMIN_BASE_PATH=/admin
